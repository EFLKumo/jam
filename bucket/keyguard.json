{
    "version": "3.2.3-20260916",
    "description": "Keyguard is an alternative client for the Bitwarden® platform, created to provide the best user experience possible",
    "homepage": "https://github.com/AChep/keyguard-app",
    "license": {
        "identifier": "Proprietary",
        "url": "https://github.com/AChep/keyguard-app/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AChep/keyguard-app/releases/download/r20260916/Keyguard-3.2.3.msi",
            "hash": "c2f3d921afcc3a166539b34d3e407e4465f7e942caa9a766dd6a12224a953c34"
        }
    },
    "bin": "Keyguard\\Keyguard.exe",
    "shortcuts": [
        [
            "Keyguard\\Keyguard.exe",
            "Keyguard"
        ]
    ],
    "post_install": [
        "$appDataPath = \"$env:LOCALAPPDATA\\ArtemChepurnyi\\keyguard\"",
        "$persistPath = \"$persist_dir\"",
        "$appData = Get-Item -LiteralPath $appDataPath -Force -ErrorAction SilentlyContinue",
        "$isJunction = [bool]($appData -and ($appData.Attributes -band [System.IO.FileAttributes]::ReparsePoint))",
        "if (-not ($isJunction -and ($appData.Target -eq $persistPath -or $appData.Target -contains $persistPath))) {",
        "    $persistHasData = (Test-Path -LiteralPath $persistPath) -and (Get-ChildItem -LiteralPath $persistPath -Force -ErrorAction SilentlyContinue | Select-Object -First 1)",
        "    if (-not $persistHasData) {",
        "        Remove-Item -LiteralPath $persistPath -Force -Recurse -ErrorAction SilentlyContinue",
        "        if ($appData -and -not $isJunction) {",
        "            Move-Item -LiteralPath $appDataPath -Destination $persistPath -Force",
        "            $appData = $null",
        "        } else {",
        "            New-Item -Path $persistPath -ItemType Directory -Force | Out-Null",
        "        }",
        "    }",
        "    if ($appData -and -not $isJunction) {",
        "        $bakName = \"keyguard.bak_$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "        Rename-Item -LiteralPath $appDataPath -NewName $bakName -Force",
        "        Write-Host \"Existing Keyguard user data has been backed up to: $bakName\" -ForegroundColor Yellow",
        "    }",
        "    if ($isJunction) {",
        "        [System.IO.Directory]::Delete($appDataPath)",
        "    }",
        "    New-Item -ItemType Junction -Path $appDataPath -Target $persistPath | Out-Null",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/AChep/keyguard-app/",
        "regex": "Release v([\\d\\.]+)-([\\d\\.]+)",
        "replace": "${1}-${2}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AChep/keyguard-app/releases/download/r$preReleaseVersion/Keyguard-$matchHead.msi"
            }
        }
    }
}
