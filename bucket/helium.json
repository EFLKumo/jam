{
    "version": "0.18.1.1",
    "description": "The Chromium-based web browser made for people, with love. Best privacy by default, unbiased ad-blocking, no bloat and no noise.",
    "homepage": "https://helium.computer",
    "license": "BSD-3-Clause, GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.18.1.1/helium_0.18.1.1_x64-windows.zip",
            "hash": "f5fddbe1912225b186c289fe8a73a67779c025829a10a415f04592b48bf24ee3",
            "extract_dir": "helium_0.18.1.1_x64-windows"
        },
        "arm64": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.18.1.1/helium_0.18.1.1_arm64-windows.zip",
            "hash": "9c8e40e8b3936f58063c1fa2a755dcefd65c063625f948b285efc6778454b492",
            "extract_dir": "helium_0.18.1.1_arm64-windows"
        }
    },
    "post_install": [
        "$targetPersist = \"$persist_dir\\User Data\"",
        "$cUserData = \"$env:LOCALAPPDATA\\imput\\Helium\\User Data\"",
        "if (-not (Test-Path -LiteralPath $targetPersist)) { New-Item -ItemType Directory -Path $targetPersist -Force | Out-Null }",
        "$parentDir = Split-Path -Path $cUserData -Parent",
        "if (-not (Test-Path -LiteralPath $parentDir)) { New-Item -ItemType Directory -Path $parentDir -Force | Out-Null }",
        "if (-not (Test-Path -LiteralPath $cUserData)) {",
        "    New-Item -ItemType Junction -Path $cUserData -Target $targetPersist | Out-Null",
        "} else {",
        "    $item = Get-Item -LiteralPath $cUserData -Force",
        "    if (-not ($item.Attributes -match 'ReparsePoint')) {",
        "        if ((Get-ChildItem -LiteralPath $targetPersist -Force | Measure-Object).Count -eq 0) {",
        "            Get-ChildItem -LiteralPath $cUserData -Force | Move-Item -Destination $targetPersist -Force",
        "            Remove-Item -LiteralPath $cUserData -Force -Recurse",
        "        } else {",
        "            $bakName = \"User Data.bak_$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "            Write-Host \"The existing Helium user data has been backed up to: $bakName\" -ForegroundColor Yellow",
        "            Rename-Item -LiteralPath $cUserData -NewName $bakName",
        "        }",
        "        New-Item -ItemType Junction -Path $cUserData -Target $targetPersist | Out-Null",
        "    }",
        "}"
    ],
    "bin": [
        [
            "chrome.exe",
            "helium"
        ]
    ],
    "shortcuts": [
        [
            "chrome.exe",
            "Helium"
        ]
    ],
    "persist": "User Data",
    "checkver": {
        "github": "https://github.com/imputnet/helium-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_x64-windows.zip",
                "extract_dir": "helium_$version_x64-windows"
            },
            "arm64": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_arm64-windows.zip",
                "extract_dir": "helium_$version_arm64-windows"
            }
        }
    }
}
