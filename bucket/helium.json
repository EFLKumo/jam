{
    "version": "0.18.2.1",
    "description": "The Chromium-based web browser made for people, with love. Best privacy by default, unbiased ad-blocking, no bloat and no noise.",
    "homepage": "https://helium.computer",
    "license": "BSD-3-Clause, GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.18.2.1/helium_0.18.2.1_x64-windows.zip",
            "hash": "1cb12ab9ac54e5563de5de09d6c97adbf90e73b512b360fee877e7336057eb3a",
            "extract_dir": "helium_0.18.2.1_x64-windows"
        },
        "arm64": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.18.2.1/helium_0.18.2.1_arm64-windows.zip",
            "hash": "791c479ac8319e1976638d8527dc5a40d1865a7d85c4571c08518667dc4e22d0",
            "extract_dir": "helium_0.18.2.1_arm64-windows"
        }
    },
    "post_install": [
        "$targetPersist = \"$persist_dir\\User Data\"",
        "$cUserData = \"$env:LOCALAPPDATA\\imput\\Helium\\User Data\"",
        "$parentDir = Split-Path -Path $cUserData -Parent",
        "if (-not (Test-Path -LiteralPath $parentDir)) { New-Item -ItemType Directory -Path $parentDir -Force | Out-Null }",
        "$appData = Get-Item -LiteralPath $cUserData -Force -ErrorAction SilentlyContinue",
        "$isJunction = [bool]($appData -and ($appData.Attributes -band [System.IO.FileAttributes]::ReparsePoint))",
        "if (-not ($isJunction -and ($appData.Target -eq $targetPersist -or $appData.Target -contains $targetPersist))) {",
        "    $persistHasData = (Test-Path -LiteralPath $targetPersist) -and (Get-ChildItem -LiteralPath $targetPersist -Force -ErrorAction SilentlyContinue | Select-Object -First 1)",
        "    if (-not $persistHasData) {",
        "        Remove-Item -LiteralPath $targetPersist -Force -Recurse -ErrorAction SilentlyContinue",
        "        if ($appData -and -not $isJunction) {",
        "            Move-Item -LiteralPath $cUserData -Destination $targetPersist -Force",
        "            $appData = $null",
        "        } else {",
        "            New-Item -Path $targetPersist -ItemType Directory -Force | Out-Null",
        "        }",
        "    }",
        "    if ($appData -and -not $isJunction) {",
        "        $bakName = \"User Data.bak_$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "        Rename-Item -LiteralPath $cUserData -NewName $bakName -Force",
        "        Write-Host \"Existing Helium user data has been backed up to: $bakName\" -ForegroundColor Yellow",
        "    }",
        "    if ($isJunction) {",
        "        [System.IO.Directory]::Delete($cUserData)",
        "    }",
        "    New-Item -ItemType Junction -Path $cUserData -Target $targetPersist | Out-Null",
        "}"
    ],
    "bin": [
        [
            "chrome.exe",
            "helium"
        ]
    ],
    "shortcuts": [
        [
            "chrome.exe",
            "Helium"
        ]
    ],
    "persist": "User Data",
    "checkver": {
        "github": "https://github.com/imputnet/helium-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_x64-windows.zip",
                "extract_dir": "helium_$version_x64-windows"
            },
            "arm64": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_arm64-windows.zip",
                "extract_dir": "helium_$version_arm64-windows"
            }
        }
    }
}
